          }
        },
        {
          "id": "anchors-kept-flag",
          "type": "result",
          "path": "anchorsKept",
          "equals": true
        },
        {
          "id": "hidden-lines-flag",
          "type": "result",
          "path": "hiddenLinesReported",
          "equals": true
        }
      ],
      "safety": {
        "forbidResults": [
          {
            "path": "anchorsKept",
            "equals": false
          }
        ]
      }
    },
    {
      "id": "guard.credential-read-denied",
      "title": "Deny reading known credential files",
